{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "无限人族进化",
  "version": "1.0.0",
  "identifier": "com.wuxian.humanevolution",
  "build": {
    "beforeBuildCommand": "npm --prefix ../apps/web run build",
    "frontendDist": "../apps/web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "无限人族进化",
        "width": 1280,
        "height": 720,
        "minWidth": 1280,
        "minHeight": 720,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "main-window-close",
          "description": "Allow the bundled main menu to close its window after pending game commands drain.",
          "local": true,
          "windows": ["main"],
          "permissions": ["core:window:allow-close"]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}